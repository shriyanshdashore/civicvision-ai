# CIVICVISION AI - Environment Variables Configuration

# Server Environment
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./civicvision.db

# JWT & Authentication Secret Key
SECRET_KEY=civicvision_secret_key_change_in_production_2026

# AI Vision Service Configuration
AI_VISION_CONFIDENCE_THRESHOLD=0.85
MAX_IMAGE_SIZE_MB=10

# GIS & Mapbox Configuration (Optional)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
